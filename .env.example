# Copy this file to ".env" and remove the # in front of the lines you need.
# Everything is optional on a PC: without a .env the program uses the defaults shown here.

# Port of the web page (start.bat / stop.bat read this too)
#PORT=8790

# Database. Empty = SQLite file in data/dailyqc.db (right for a PC).
# On a free host use PostgreSQL, e.g. the connection string from neon.tech:
#DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Password given to the first "admin" account when the database is empty
#ADMIN_PASSWORD=admin1234

# Session signing key. On a PC one is generated in data/secret.key. On a host set a long random text.
#SECRET_KEY=change-me-to-a-long-random-text

# Protects /cron/tick (the address an outside pinger calls to trigger scheduled reports on a free host)
#CRON_KEY=some-random-text

# Factory time zone, hours from UTC (Thailand = 7)
#TZ_OFFSET_HOURS=7

# Force "hosted" behaviour (no shutdown button, no local backups). Render / Koyeb / Railway are detected automatically.
#HOSTED=1

# "Secure" session cookie. Automatic on Render / Koyeb / Railway. Set to 1 when you run behind your own HTTPS proxy.
#COOKIE_SECURE=1

# Rescue for a forgotten admin password on a host: set to 1, restart, log in as admin with ADMIN_PASSWORD,
# then remove this line again.
#RESET_ADMIN_PASSWORD=1
